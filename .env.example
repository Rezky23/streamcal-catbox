# ==========================================
# STREAMCAL CONFIGURATION (.env)
# ==========================================

# Server Port
PORT=3000

# Base URL (for generating direct image links)
# In production, change this to your domain, e.g., https://streamcal.example.com
BASE_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streamcal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/streamcal?retryWrites=true&w=majority

# Upload Limits (in Megabytes)
# Restricted to image and audio (max 2MB)
MAX_FILE_SIZE_MB=2

# Environment Mode: development / production
NODE_ENV=production

# ==========================================
# TAKO.ID SUPPORT CONFIGURATION (https://tako.id/api-docs)
# ==========================================
# Get your Personal API Key from https://tako.id/me/api-keys
TAKO_API_KEY=your_tako_api_key_here
# Your Tako creator username (e.g. streamcal)
TAKO_USERNAME=your_tako_username
# Optional: Webhook secret if configured in your Tako API Keys dashboard for HMAC-SHA256 signature verification
TAKO_WEBHOOK_SECRET=your_optional_webhook_secret

