# ==========================================
# STREAMCAL CONFIGURATION (.env)
# ==========================================

# Server Port
PORT=3000

# Base URL (for generating direct image links)
# In production, change this to your domain, e.g., https://streamcal.example.com
BASE_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streamcal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/streamcal?retryWrites=true&w=majority

# Upload Limits (in Megabytes)
# Restricted to image and audio (max 2MB)
MAX_FILE_SIZE_MB=2

# Environment Mode: development / production
NODE_ENV=production

